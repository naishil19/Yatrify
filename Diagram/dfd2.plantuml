@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false


' ================= EXTERNAL ENTITIES =================
rectangle "User" as User
rectangle "AI Service\n(Gemini)" as Gemini
rectangle "Image API\n(Unsplash)" as Unsplash

' ================= SUB-PROCESSES =================
circle "2.1\nEnter Trip\nDetails" as P21
circle "2.2\nValidate Trip\nData" as P22
circle "2.3\nCheck and\nUpdate Credits" as P23
circle "2.4\nGenerate or\nRefine Plan" as P24
circle "2.5\nUpdate\nItinerary" as P25
circle "2.6\nSave / Fetch /\nDelete Plan" as P26
circle "2.7\nDisplay Plan" as P27

' ================= DATA STORES =================
database "D1\nUser Data\nand Credits" as D1
database "D2\nPlan Data" as D2

' ================= MAIN FLOW =================
User --> P21 : Trip details / plan request
P21 --> P22 : Trip details

P22 --> P23 : Validated data
P22 --> User : Invalid input / error

P23 --> D1 : Fetch credits
D1 --> P23 : Credits available
P23 --> P24 : Credits OK
P23 --> User : Insufficient credits / stop

P24 --> Gemini : Generate / refine prompt
Gemini --> P24 : Plan sections
P24 --> Unsplash : Destination query
P24 --> P25 : Generated plan
Unsplash --> P27 : Hero image

User --> P25 : Edit itinerary day
P25 --> D2 : Fetch current itinerary
D2 --> P25 : Current itinerary
P25 --> P26 : Final plan

User --> P26 : Open plan / delete plan
P26 --> D2 : Save plan
P26 --> D2 : Delete plan
D2 --> P26 : Fetched plan
P26 --> D1 : Update credits
D1 --> P26 : Updated credits
P26 --> P27 : Saved plan / fetched plan

P27 --> User : Generated / refined / updated plan

@enduml
