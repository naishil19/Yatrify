@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false

title Yatrify ER Diagram

' ================= ENTITIES =================
rectangle "User" as User
rectangle "Plan" as Plan
rectangle "Expense" as Expense
rectangle "PlanCollaborator" as Collaborator
rectangle "CreditTransaction" as CreditTx
rectangle "CommunityPlan" as Community
rectangle "PlanCatalog" as Catalog
rectangle "CatalogFeature" as CatalogFeature

' ================= USER ATTRIBUTES =================
usecase "user_id (PK)" as u1
usecase "clerk_user_id" as u2
usecase "email" as u3
usecase "credits" as u4
usecase "plan_tier" as u5
User -- u1
User -- u2
User -- u3
User -- u4
User -- u5

' ================= PLAN ATTRIBUTES =================
usecase "plan_id (PK)" as p1
usecase "destination" as p2
usecase "start_date" as p3
usecase "end_date" as p4
usecase "currency" as p5
usecase "is_published" as p6
Plan -- p1
Plan -- p2
Plan -- p3
Plan -- p4
Plan -- p5
Plan -- p6

' ================= EXPENSE ATTRIBUTES =================
usecase "expense_id (PK)" as e1
usecase "description" as e2
usecase "category" as e3
usecase "amount" as e4
usecase "date" as e5
Expense -- e1
Expense -- e2
Expense -- e3
Expense -- e4
Expense -- e5

' ================= COLLABORATOR ATTRIBUTES =================
usecase "collaborator_id (PK)" as c1
usecase "invited_email" as c2
usecase "role" as c3
usecase "status" as c4
Collaborator -- c1
Collaborator -- c2
Collaborator -- c3
Collaborator -- c4

' ================= CREDIT ATTRIBUTES =================
usecase "transaction_id (PK)" as ct1
usecase "delta" as ct2
usecase "reason" as ct3
CreditTx -- ct1
CreditTx -- ct2
CreditTx -- ct3

' ================= COMMUNITY ATTRIBUTES =================
usecase "community_id (PK)" as cp1
usecase "source" as cp2
usecase "published_at" as cp3
Community -- cp1
Community -- cp2
Community -- cp3

' ================= CATALOG ATTRIBUTES =================
usecase "catalog_id (PK)" as pc1
usecase "name" as pc2
usecase "price_amount" as pc3
usecase "credits_included" as pc4
Catalog -- pc1
Catalog -- pc2
Catalog -- pc3
Catalog -- pc4

' ================= FEATURE ATTRIBUTES =================
usecase "feature_id (PK)" as pf1
usecase "text" as pf2
usecase "sort_order" as pf3
CatalogFeature -- pf1
CatalogFeature -- pf2
CatalogFeature -- pf3

' ================= RELATIONSHIPS =================
User "1" -- "0..N" Plan : creates
Plan "1" -- "0..N" Expense : tracks
User "1" -- "0..N" Expense : records
Plan "1" -- "0..N" Collaborator : shares
User "0..N" -- "0..1" Collaborator : joins
User "1" -- "0..N" CreditTx : has
Plan "0..1" -- "0..N" CreditTx : logs
Plan "0..1" -- "1" Community : publishes
Catalog "1" -- "0..N" CatalogFeature : includes

@enduml
