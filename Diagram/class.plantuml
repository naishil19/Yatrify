@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle


package "Domain" {
  class User {
    +id: int
    +email: String
    +credits: decimal
    +planTier: String
    --
    +generatePlan(): void
    +viewPlans(): void
    +purchaseCredits(): void
  }

  class Plan {
    +id: UUID
    +destination: String
    +startDate: Date
    +endDate: Date
    +budget: String
    +currency: String
    +isPublished: boolean
    --
    +refinePlan(): void
    +publish(): void
    +unpublish(): void
    +delete(): void
  }

  class ItineraryDay {
    +dayNumber: int
    +title: String
    +morning: String
    +afternoon: String
    +evening: String
    +night: String
    --
    +editDay(): void
  }

  class Expense {
    +id: UUID
    +description: String
    +amount: decimal
    +category: String
    +date: Date
    --
    +addExpense(): void
    +updateExpense(): void
    +deleteExpense(): void
  }

  class CollaboratorInvite {
    +id: UUID
    +invitedEmail: String
    +status: String
    --
    +sendInvite(): void
    +acceptInvite(): void
    +revokeInvite(): void
  }

  class CreditTransaction {
    +id: UUID
    +delta: decimal
    +reason: String
    +createdAt: Timestamp
    --
    +recordTransaction(): void
  }
}

package "Services" {
  class YatrifyPlanService {
    +generatePlan(): Plan
    +refinePlan(): Plan
    +updateItinerary(): Plan
    +inviteCollaborator(): CollaboratorInvite
    +createExpense(): Expense
    +publishPlan(): Plan
  }
}

User "1" --> "0..*" Plan : owns
Plan "1" *-- "1..*" ItineraryDay : contains
Plan "1" o-- "0..*" Expense : tracks
Plan "1" o-- "0..*" CollaboratorInvite : shares with
User "1" --> "0..*" CreditTransaction : has

Expense "0..*" --> "1" User : created by
CreditTransaction "0..*" --> "0..1" Plan : related to

YatrifyPlanService ..> User
YatrifyPlanService ..> Plan
YatrifyPlanService ..> ItineraryDay
YatrifyPlanService ..> Expense
YatrifyPlanService ..> CollaboratorInvite

@enduml
