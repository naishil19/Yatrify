@startuml
skinparam monochrome true
skinparam shadowing false


start

:Open Yatrify website;

if (Signed in?) then (Yes)
  :Open dashboard;
else (No)
  :Sign in / Sign up with Clerk;
  :Open dashboard;
endif

if (Create new plan?) then (Yes)
  :Enter trip details;
  :Validate trip details;
  :Check available credits;

  if (Valid input and enough credits?) then (Yes)
    :Generate AI travel plan;
    :Fetch destination hero image;
    :Save plan;
    :View plan;
  else (No)
    :Show validation or credit error;
    :Return to dashboard;
  endif
else (No)
  if (Open existing plan?) then (Yes)
    :View plan;
  else (No)
    :Browse community plans;
    :View community plan (read-only);
    :Return to dashboard;
  endif
endif

if (Refine plan?) then (Yes)
  :Check credits;
  if (Enough credits?) then (Yes)
    :Refine plan with AI;
    :Save updated plan;
  else (No)
    :Show insufficient credits;
  endif
else (No)
endif

if (Edit itinerary?) then (Yes)
  :Update itinerary day;
  :Save itinerary changes;
else (No)
endif

if (Manage collaborators?) then (Yes)
  :Invite or revoke collaborator;
  :Collaborator accepts invite;
  :Access shared plan;
else (No)
endif

if (Track expenses?) then (Yes)
  :Add, edit, or delete expense;
  :View updated expense total;
else (No)
endif

if (Publish or unpublish plan?) then (Yes)
  :Update community visibility;
else (No)
endif

if (Open settings?) then (Yes)
  :Update currency or display name;
  if (Delete plan?) then (Yes)
    :Delete travel plan;
    :Return to dashboard;
  else (No)
  endif
else (No)
endif

:Return to dashboard;
:Sign out;
stop

@enduml
