@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false

' ================= EXTERNAL ENTITIES =================
rectangle "User" as User
rectangle "Collaborator" as Collab
rectangle "Auth Service\n(Clerk)" as Auth
rectangle "AI Service\n(Gemini)" as AI
rectangle "Image API\n(Unsplash)" as Img
rectangle "Email Service" as Email

' ================= MAIN PROCESS =================
Circle "Yatrify System" as System

' ================= DATA STORE =================
database "D1\nYatrify Database" as DB

' ================= USER FLOWS =================
User --> System : Sign in, create/refine plan,\nedit itinerary, manage settings,\ntrack expenses, publish plan
System --> User : Dashboard, generated plan,\nupdated itinerary, expenses,\ncommunity plan view, credits

Collab --> System : Accept invite,\nopen shared plan, edit shared plan
System --> Collab : Invite access,\nshared itinerary

' ================= SERVICE FLOWS =================
System --> Auth : Authentication request
Auth --> System : User session / identity

System --> AI : Trip details / refine prompt
AI --> System : Generated plan sections

System --> Img : Destination image request
Img --> System : Hero image

System --> Email : Collaboration invite email
Email --> System : Delivery status

' ================= DATA STORE FLOWS =================
System --> DB : Save users, plans, collaborators,\nexpenses, publish state, credits
DB --> System : User data, plans, invites,\nexpenses, community plans

@enduml
