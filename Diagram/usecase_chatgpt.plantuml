@startuml
left to right direction
skinparam packageStyle rectangle

actor User
actor Collaborator

rectangle "Yatrify - Personalized AI Travel Planner" {
    User --> (Sign Up)
    User --> (Sign In)
    User --> (Sign Out)
    User --> (View Dashboard)
    User --> (Create Travel Plan)
    User --> (View Generated Plan)
    User --> (Refine Plan)
    User --> (Edit Itinerary)
    User --> (Invite Collaborator)
    User --> (Track Expenses)
    User --> (Manage Settings)
    User --> (Delete Travel Plan)
    User --> (Publish Plan)
    User --> (Unpublish Plan)
    User --> (View Community Plans)
    User --> (View Community Plan)
    User --> (Open Booking Links)
    User --> (Purchase Credits)

    Collaborator --> (Accept Collaboration Invite)
    Collaborator --> (Edit Shared Plan)

    (Create Travel Plan) --> (Enter Trip Details)
    (Create Travel Plan) --> (Generate AI Travel Plan)

    (Track Expenses) --> (Add Expense)
    (Track Expenses) --> (View Expenses)
}

@enduml
