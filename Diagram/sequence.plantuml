@startuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam linetype ortho

actor User
participant "Frontend UI" as UI
participant "Auth Service (Clerk)" as Auth
participant "Backend Server" as BE
participant "AI Service (Gemini)" as AI
participant "Image API (Unsplash)" as IMG
participant "Email Service" as Mail
database "Database" as DB

' ================= AUTH =================
User -> UI : Sign in / Sign up
UI -> Auth : authenticate()
Auth --> UI : session / token

' ================= GENERATE PLAN =================
User -> UI : Enter trip details
UI -> BE : generate plan request
BE -> DB : check user, plan tier, credits
DB --> BE : user data

alt Valid trip and enough credits
    BE -> AI : generate plan
    AI --> BE : plan sections
    BE -> DB : save plan + deduct credits
    DB --> BE : generated plan saved
    BE -> IMG : fetch hero image
    IMG --> BE : image URL
    BE --> UI : generated plan
else Invalid dates / insufficient credits
    BE --> UI : error
end

' ================= REFINE / EDIT PLAN =================
User -> UI : Refine plan / edit itinerary
UI -> BE : refine or update itinerary
BE -> DB : check access + current plan
DB --> BE : plan access

alt Refine allowed
    BE -> AI : regenerate plan
    AI --> BE : updated sections
    BE -> DB : update plan + sections + credits
    DB --> BE : updated plan
    BE --> UI : updated plan
else No access / no credits
    BE --> UI : error
end

' ================= COLLABORATE / PUBLISH / COMMUNITY =================
User -> UI : Invite collaborator
UI -> BE : invite collaborator
BE -> DB : check limit + save invite
DB --> BE : invite status

alt Invite allowed
    BE -> Mail : send invite email
    Mail --> BE : delivery status
    BE --> UI : invite result
else Limit reached / invalid invite
    BE --> UI : error
end

User -> UI : Publish / unpublish plan
UI -> BE : publish or unpublish
BE -> DB : update plan status + community entry
DB --> BE : success
BE --> UI : success

User -> UI : View community plans
UI -> BE : fetch community plans
BE -> DB : read published plans
DB --> BE : plans
BE --> UI : plans

' ================= EXPENSE TRACKING =================
User -> UI : Add / view expenses
UI -> BE : expense request
BE -> DB : save or fetch expenses
DB --> BE : updated expenses / total
BE --> UI : updated expenses / total

@enduml
