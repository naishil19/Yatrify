@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false

' ================= EXTERNAL ENTITIES =================
rectangle "User" as User
rectangle "Collaborator" as Collab
rectangle "Auth Service\n(Clerk)" as Clerk
rectangle "AI Service\n(Gemini)" as Gemini

' ================= PROCESSES =================
circle "1.0\nUser Account" as P1
circle "2.0\nTravel Plan\nManagement" as P2
circle "3.0\nCollaboration\nand Community" as P3

' ================= DATA STORES =================
database "D1\nUser Data\nand Credits" as D1
database "D2\nPlan Data" as D2

' ================= ACCOUNT =================
User --> P1 : Sign in / Sign up /\nupdate profile
P1 --> Clerk : Verify identity
Clerk --> P1 : Session
P1 --> D1 : Save / fetch user data
D1 --> P1 : Profile / credits
P1 --> User : Account status

' ================= PLAN =================
User --> P2 : Create / open / refine /\nedit / delete plan /\nmanage expenses
P2 --> Gemini : Generate / refine plan
Gemini --> P2 : Plan sections
P2 --> D1 : Read / update credits
P2 --> D2 : Save / fetch plan data
D2 --> P2 : Plan / itinerary / expenses
P2 --> User : Generated or updated plan

' ================= COLLABORATION + COMMUNITY =================
User --> P3 : Invite / revoke /\npublish / browse community
Collab --> P3 : Accept invite /\nopen shared plan
P3 --> D2 : Save invites / shared access /\npublish status
D2 --> P3 : Shared plans /\ncommunity plans
P3 --> User : Invite status /\npublic plans
P3 --> Collab : Shared access

@enduml
